# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- cqrTalk server configuration -------------------------------------------

# PORT: HTTP/WebSocket listen port (default 3000).
PORT=3000

# TRUST_PROXY: set to "true" when running behind a reverse proxy (Vercel,
# Cloud Run, Fly.io, Render, nginx...) so rate-limit keys use the real client
# IP from X-Forwarded-For instead of the proxy's address.
TRUST_PROXY="true"

# TURN relay (recommended for production). Without a TURN server, WebRTC calls
# fail between peers behind symmetric NATs / strict corporate firewalls.
# Can be a comma-separated list of turn: URLs. Optionally protect with
# credentials (prefer short-lived credentials in production).
# TURN_URL="turn:turn.example.com:3478?transport=udp"
# TURN_USERNAME="cqrtalk"
# TURN_CREDENTIAL="change-me"

# OFFLINE_NOTIFY_DELAY_MS: grace period before other operators are told a peer
# went offline (lets quick reconnects avoid flapping). Default 4000.
# OFFLINE_NOTIFY_DELAY_MS=4000
